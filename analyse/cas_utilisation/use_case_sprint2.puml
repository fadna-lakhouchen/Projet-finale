@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

' Define actors
actor "Résident" as Resident
actor "Syndic" as Syndic
actor "Administrateur" as Admin

rectangle "Système ImmoSyndic - Évolutions Sprint 2 (Fonctions Avancées)" {

  ' --- Espace RESIDENT (Incrément) ---
  package "Nouveautés Résident" {
    Resident -- (Consulter l'historique complet des actions)
    Resident -- (Télécharger les quittances et documents PDF)
    Resident -- (Gérer les alertes et notifications personnalisées)
  }

  ' --- Espace SYNDIC (Incrément) ---
  package "Nouveautés Syndic" {
    Syndic -- (Planifier les interventions via Calendrier)
    Syndic -- (Consulter les tableaux de bord analytiques)
    Syndic -- (Gérer l'archivage des documents AG/Contrats)
    Syndic -- (Diffuser des messages groupés aux résidents)
  }

  ' --- Espace ADMINISTRATEUR (Incrément) ---
  package "Nouveautés Administrateur" {
    Admin -- (Générer des rapports financiers consolidés)
    Admin -- (Consulter le journal d'audit du système)
    Admin -- (Gérer les droits d'accès avancés)
    Admin -- (Superviser les flux de communication)
  }

}

note right of (Planifier les interventions via Calendrier)
  Évolution du "Suivi simple" du Sprint 1
end note

@enduml
