@startuml ImmoSyndic_Global_Resident
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor "Résident" as Resident
actor "Mobile" as Mobile

rectangle "Système ImmoSyndic - Espace Résident" {

  package "Authentification" {
    usecase "S'authentifier" as Auth
  }

  package "Finances & Cotisations" {
    usecase "Consulter ses cotisations" as ViewPayments
    usecase "Déclarer une cotisation prête" as SignalReady
  }

  package "Incidents & Pannes" {
    usecase "Signaler un problème" as ReportIssue
  }

  package "Informations & Transparence" {
    usecase "Consulter la transparence financière" as ViewTransparency
    usecase "Consulter les annonces" as ViewNews
    usecase "Gérer les documents" as ViewDocs
  }

  package "Paramètres" {
    usecase "Gérer son profil" as ManageProfile
    usecase "Recevoir des notifications" as GetNotifs
  }

  package "API Mobile" {
    usecase "Consommer API" as ProvideAPI
  }

  ' Auth relation (global rule)
  ViewPayments ..> Auth : <<include>>
  SignalReady ..> Auth : <<include>>
  ReportIssue ..> Auth : <<include>>
  ViewTransparency ..> Auth : <<include>>
  ViewNews ..> Auth : <<include>>
  ViewDocs ..> Auth : <<include>>
  ManageProfile ..> Auth : <<include>>
  GetNotifs ..> Auth : <<include>>
}

' Résident utilise web
Resident -- ViewPayments
Resident -- SignalReady
Resident -- ReportIssue
Resident -- ViewTransparency
Resident -- ViewNews
Resident -- ViewDocs
Resident -- ManageProfile
Resident -- GetNotifs

' Mobile consomme API
Mobile -- ProvideAPI

@enduml