@startuml ImmoSyndic_Global_Admin
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor "Administrateur" as Admin


rectangle "Système ImmoSyndic - Global (Vision Administrateur)" {

  package "Authentification" {
    usecase "S'authentifier" as Auth
  }

  package "Portail Web (Administration)" {
    package "Espace Administrateur (Web)" {
      usecase "Gérer comptes" as ManageUsers
      usecase "Superviser immeubles" as Supervise
      usecase "Gérer droits" as ManageRoles
      usecase "Valider données" as ValidateData
      usecase "Générer rapports" as GlobalReports
      usecase "Consulter audit" as AuditLogs
      usecase "Surveiller activités" as MonitorActivity

      ManageUsers ..> Auth : <<include>>
      Supervise ..> Auth : <<include>>
      ManageRoles ..> Auth : <<include>>
      ValidateData ..> Auth : <<include>>
      GlobalReports ..> Auth : <<include>>
      AuditLogs ..> Auth : <<include>>
      MonitorActivity ..> Auth : <<include>>
    }
  }

}

' Web Connections
Admin -- ManageUsers
Admin -- Supervise
Admin -- ManageRoles
Admin -- ValidateData
Admin -- GlobalReports
Admin -- AuditLogs
Admin -- MonitorActivity


@enduml
