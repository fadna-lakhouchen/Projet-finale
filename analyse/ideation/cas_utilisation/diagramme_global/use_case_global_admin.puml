@startuml ImmoSyndic_Global_Admin
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor "Administrateur" as Admin


rectangle "Système ImmoSyndic -Espace Administrateur" {

  package "Authentification" {
    usecase "S'authentifier" as Auth
  }
    package "Espace Administrateur (Web)" {
      usecase "Gérer comptes syndic" as ManageSyndic
       usecase "Gérer comptes résidents" as ManageResidents
      usecase "Gérer droits" as ManageRoles
      usecase "Générer rapports" as GlobalReports
      usecase "Exporter Excel" as ExportExcel
      usecase "Exporter PDF" as ExportPDF
      usecase "Consulter logs système" as AuditLogs
      usecase "Surveiller activités" as MonitorActivity

      ManageSyndic ..> Auth : <<include>>
      ManageResidents ..> Auth : <<include>>
      ManageRoles ..> Auth : <<include>>
      GlobalReports ..> Auth : <<include>>
      ExportExcel ..> Auth : <<include>>
      ExportPDF ..> Auth : <<include>>
      AuditLogs ..> Auth : <<include>>
      MonitorActivity ..> Auth : <<include>>
    }
  

}

' Web Connections
Admin -- ManageSyndic
Admin -- ManageResidents
Admin -- ManageRoles
Admin -- GlobalReports
Admin -- ExportExcel
Admin -- ExportPDF
Admin -- AuditLogs
Admin -- MonitorActivity


@enduml
