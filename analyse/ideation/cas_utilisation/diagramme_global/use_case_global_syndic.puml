@startuml ImmoSyndic_Final_Syndic
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

' Acteurs Syndics avec Héritage
actor "Syndic Secondaire" as SyndicSec
actor "Syndic Principal" as SyndicPri

' Le Syndic Principal hérite du Syndic Secondaire
SyndicPri -up-|> SyndicSec

rectangle "Système ImmoSyndic - Espace Syndic" {

  package "Authentification" {
    usecase "S'authentifier" as Auth
  }

  package "Gestion principale" {
    usecase "Gérer immeubles" as ManageBuildings
    usecase "Gérer résidents" as ManageResidents
    usecase "Gérer cotisations" as ManageCharges
    usecase "Suivre paiements" as TrackPayments
    usecase "Gérer dépenses" as ManageExpenses
  }

  package "Opérations quotidiennes" {
    usecase "Suivre interventions" as TrackInterventions
    usecase "Envoyer annonces" as SendNews
    usecase "Gérer documents" as ManageDocs
  }

  package "Rapports" {
    usecase "Consulter statistiques" as ViewStats
    usecase "Exporter Excel" as ExportExcel
    usecase "Exporter PDF" as ExportPDF
  }

  package "Sécurité & Équipe" {
    usecase "Gérer les syndics secondaires" as ManageSecondaries
    usecase "Consulter le journal d'activité (Logs)" as ViewLogs
  }

  package "Paramètres" {
    usecase "Gérer son profil" as ManageProfile
    usecase "Consulter la facturation" as ManageSubscription
  }

  ' Auth relation (global rule)
  ManageBuildings ..> Auth : <<include>>
  ManageResidents ..> Auth : <<include>>
  ManageCharges ..> Auth : <<include>>
  TrackPayments ..> Auth : <<include>>
  ManageExpenses ..> Auth : <<include>>
  TrackInterventions ..> Auth : <<include>>
  SendNews ..> Auth : <<include>>
  ManageDocs ..> Auth : <<include>>
  ViewStats ..> Auth : <<include>>
  ExportExcel ..> Auth : <<include>>
  ExportPDF ..> Auth : <<include>>
  ManageSecondaries ..> Auth : <<include>>
  ViewLogs ..> Auth : <<include>>
  ManageProfile ..> Auth : <<include>>
  ManageSubscription ..> Auth : <<include>>
}

' Actor connections
' Le Syndic Secondaire est lié aux fonctionnalités quotidiennes, de gestion et profil
SyndicSec -- ManageBuildings
SyndicSec -- ManageResidents
SyndicSec -- ManageCharges
SyndicSec -- TrackPayments
SyndicSec -- ManageExpenses
SyndicSec -- TrackInterventions
SyndicSec -- SendNews
SyndicSec -- ManageDocs
SyndicSec -- ViewStats
SyndicSec -- ExportExcel
SyndicSec -- ExportPDF
SyndicSec -- ManageProfile

' Le Syndic Principal est le seul lié aux fonctionnalités d'équipe, de sécurité et abonnement
SyndicPri -- ManageSecondaries
SyndicPri -- ViewLogs
SyndicPri -- ManageSubscription

@enduml