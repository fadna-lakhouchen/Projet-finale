@startuml ImmoSyndic_Final_Syndic
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor "Syndic" as Syndic

rectangle "Système ImmoSyndic - Espace Syndic" {

  package "Authentification" {
    usecase "S'authentifier" as Auth
  }

  package "Gestion principale" {
    usecase "Gérer immeubles" as ManageBuildings
    usecase "Gérer résidents" as ManageResidents
    usecase "Gérer charges" as ManageCharges
    usecase "Suivre paiements" as TrackPayments
  }

  package "Opérations quotidiennes" {
    usecase "Suivre interventions" as TrackInterventions
    usecase "Envoyer annonces" as SendNews
    usecase "Gérer documents" as ManageDocs
  }

  package "Rapports" {
    usecase "Consulter statistiques" as ViewStats
    usecase "Exporter Excel" as ExportExcel
    usecase "Exporter PDF" as ExportPDF
  }
}
  ' Auth relation (global rule)
  ManageBuildings ..> Auth : <<include>>
  ManageResidents ..> Auth : <<include>>
  ManageCharges ..> Auth : <<include>>
  TrackPayments ..> Auth : <<include>>
  TrackInterventions ..> Auth : <<include>>
  SendNews ..> Auth : <<include>>
  ManageDocs ..> Auth : <<include>>
  ViewStats ..> Auth : <<include>>
  ExportExcel ..> Auth : <<include>>
  ExportPDF ..> Auth : <<include>>
}

' Actor connections
Syndic -- ManageBuildings
Syndic -- ManageResidents
Syndic -- ManageCharges
Syndic -- TrackPayments
Syndic -- TrackInterventions
Syndic -- SendNews
Syndic -- ManageDocs
Syndic -- ViewStats
Syndic -- ExportExcel
Syndic -- ExportPDF

@enduml