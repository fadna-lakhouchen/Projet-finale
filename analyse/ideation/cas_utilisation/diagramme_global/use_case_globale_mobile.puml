@startuml ImmoSyndic_Mobile_Resident
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor "Résident" as Resident
actor "web" as web

rectangle "Application Mobile ImmoSyndic - Espace Résident" {

  package "Authentification" {
    usecase "S'authentifier" as Auth
  }

  package "Espace Résident" {

    usecase "Consulter charges" as ViewCharges
    usecase "Signaler problème" as ReportIssue
    usecase "Recevoir notifications" as GetNotifs
    usecase "Consulter archives" as ViewArchives
    usecase "Exporter PDF" as ExportPDF
    usecase "Exporter Excel" as ExportExcel
    usecase "Personnaliser alertes" as SetAlerts
    usecase "Consulter annonces" as ViewNews

    ViewCharges ..> Auth : <<include>>
    ReportIssue ..> Auth : <<include>>
    GetNotifs ..> Auth : <<include>>
    ViewArchives ..> Auth : <<include>>
    ExportPDF ..> Auth : <<include>>
    ExportExcel ..> Auth : <<include>>
    SetAlerts ..> Auth : <<include>>
    ViewNews ..> Auth : <<include>>
  }

  package "API" {
    usecase "Fournir API" as ProvideAPI
  }
}

' Resident interacts with web system
Resident -- ViewCharges
Resident -- ReportIssue
Resident -- GetNotifs
Resident -- ViewArchives
Resident -- ExportPDF
Resident -- ExportExcel
Resident -- SetAlerts
Resident -- ViewNews

' web consumes web API
web -- ProvideAPI

@enduml