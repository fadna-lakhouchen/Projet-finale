@startuml ImmoSyndic_Mobile_Resident
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor "Résident" as Resident
actor "web" as web

rectangle "Sprint 2 - Mobile Immosyndic" {

  package "Authentification" {
    usecase "S'authentifier" as Auth
  }

  package "Espace Résident" {

    usecase "Consulter archives" as ViewArchives
    usecase "Exporter PDF" as ExportPDF
    usecase "Exporter Excel" as ExportExcel
    usecase "Personnaliser alertes" as SetAlerts

   
    ViewArchives ..> Auth : <<include>>
    ExportPDF ..> Auth : <<include>>
    ExportExcel ..> Auth : <<include>>
    SetAlerts ..> Auth : <<include>>
  }

  package "API" {
    usecase "Fournir API" as ProvideAPI
  }
}

' Resident interacts with web system
Resident -- ViewArchives
Resident -- ExportPDF
Resident -- ExportExcel
Resident -- SetAlerts

' web consumes web API
web -- ProvideAPI

@enduml