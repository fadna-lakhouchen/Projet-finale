@startuml ImmoSyndic_Global
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

' Actors
actor "Résident" as Resident
actor "Syndic" as Syndic
actor "Administrateur" as Admin

' Hierarchy
Resident <|-- Syndic
Syndic <|-- Admin

rectangle "Système ImmoSyndic (Solution Web & Mobile) - Global" {

  package "Authentification & Profil" {
    usecase "S'authentifier" as Auth
    usecase "Gérer son profil" as Profile
  }

  package "Portail Web (Gestion & Administration)" {
    
    package "Espace Résident (Web)" {
      usecase "Consulter charges" as ViewChargesWeb
      usecase "Signaler problème" as ReportIssueWeb
      usecase "Recevoir notifications" as GetNotifsWeb
      usecase "Consulter archives" as ViewArchivesWeb
      usecase "Exporter PDF" as ExportPDFWeb
      usecase "Personnaliser alertes" as SetAlertsWeb

      ViewChargesWeb ..> Auth : <<include>>
      ReportIssueWeb ..> Auth : <<include>>
      ViewArchivesWeb ..> Auth : <<include>>
      SetAlertsWeb ..> Auth : <<include>>
    }

    package "Espace Syndic (Web)" {
      usecase "Créer compte" as Register
      usecase "Gérer les Résidents" as ManageResidents
      usecase "Gérer immeubles" as ManageBuildings
      usecase "Suivre paiements" as TrackPayments
      usecase "Générer reçus" as GenReceipts
      usecase "Suivre interventions" as TrackInterventions
      usecase "Gérer planning" as ManagePlanning
      usecase "Analyser statistiques" as ViewStats
      usecase "Envoyer annonces" as SendNews
      usecase "Gérer archivage" as ArchiveDocs

      Register ..> Auth : <<include>>
      ManageResidents ..> Auth : <<include>>
      ManageBuildings ..> Auth : <<include>>
      TrackPayments ..> Auth : <<include>>
      TrackInterventions ..> Auth : <<include>>
    }

    package "Espace Administrateur (Web)" {
      usecase "Gérer comptes" as ManageUsers
      usecase "Superviser immeubles" as Supervise
      usecase "Gérer droits" as ManageRoles
      usecase "Valider données" as ValidateData
      usecase "Générer rapports" as GlobalReports
      usecase "Consulter audit" as AuditLogs
      usecase "Surveiller activités" as MonitorActivity

      ManageUsers ..> Auth : <<include>>
      ManageRoles ..> Auth : <<include>>
      AuditLogs ..> Auth : <<include>>
    }
  }

  package "Application Mobile (Viewer / Consultation)" {
    usecase "Consulter mes charges" as MobileViewCharges
    usecase "Voir mes notifications" as MobileViewNotifs
    usecase "Consulter archives" as MobileViewArchives
    usecase "Visualiser statistiques" as MobileViewStats
    usecase "Consulter historique global" as MobileViewHistory

    MobileViewCharges ..> Auth : <<include>>
    MobileViewNotifs ..> Auth : <<include>>
    MobileViewArchives ..> Auth : <<include>>
    MobileViewStats ..> Auth : <<include>>
    MobileViewHistory ..> Auth : <<include>>
  }
}

' Web Connections
Resident -- ViewChargesWeb
Resident -- ReportIssueWeb
Resident -- GetNotifsWeb
Resident -- ViewArchivesWeb
Resident -- ExportPDFWeb
Resident -- SetAlertsWeb

Syndic -- Register
Syndic -- ManageResidents
Syndic -- ManageBuildings
Syndic -- TrackPayments
Syndic -- GenReceipts
Syndic -- TrackInterventions
Syndic -- ManagePlanning
Syndic -- ViewStats
Syndic -- SendNews
Syndic -- ArchiveDocs

Admin -- ManageUsers
Admin -- Supervise
Admin -- ManageRoles
Admin -- ValidateData
Admin -- GlobalReports
Admin -- AuditLogs
Admin -- MonitorActivity

' Mobile Connections (Consultation Only)
Resident -- MobileViewCharges
Resident -- MobileViewNotifs
Resident -- MobileViewArchives

Syndic -- MobileViewCharges
Syndic -- MobileViewStats

Admin -- MobileViewStats
Admin -- MobileViewHistory

@enduml
