@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor "Résident" as Resident
actor "Syndic" as Syndic
actor "Administrateur" as Admin

rectangle "Système ImmoSyndic (Solution Web & Mobile) - Global" {

  ' --- Authentification & Profil ---
  usecase "S'authentifier" as Auth
  usecase "Gérer profil" as Profile
  Resident -- Auth
  Syndic -- Auth
  Admin -- Auth
  Resident -- Profile
  Syndic -- Profile
  Admin -- Profile

  ' --- Espace RESIDENT ---
  package "Espace Résident" {
    Resident -- (Créer compte)
    Resident -- (Consulter charges)
    Resident -- (Signaler problème)
    Resident -- (Recevoir notifications)
    Resident -- (Consulter archives)
    Resident -- (Exporter PDF)
    Resident -- (Personnaliser alertes)
  }

  ' --- Espace SYNDIC ---
  package "Espace Syndic" {
    Syndic -- (Gérer immeubles)
    Syndic -- (Suivre paiements)
    Syndic -- (Générer reçus)
    Syndic -- (Suivre interventions)
    Syndic -- (Consulter historique)
    Syndic -- (Gérer planning)
    Syndic -- (Analyser statistiques)
    Syndic -- (Gérer archivage)
    Syndic -- (Envoyer annonces)
  }

  ' --- Espace ADMINISTRATEUR ---
  package "Espace Administrateur" {
    Admin -- (Gérer comptes)
    Admin -- (Superviser immeubles)
    Admin -- (Valider données)
    Admin -- (Gérer droits)
    Admin -- (Générer rapports)
    Admin -- (Consulter audit)
    Admin -- (Surveiller activités)
  }

}
@enduml